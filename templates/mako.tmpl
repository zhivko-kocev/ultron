# Written by `ultron apply` from the current theme. Never edit: put your changes in ~/.config/ultron/mako.
font=JetBrains Mono 10
background-color=#@BG@
text-color=#@FG@
border-color=#@ACCENT@
border-size=2
border-radius=4
default-timeout=8000

# mako reads include only before the first [criteria] section.
include=~/.config/ultron/mako

[app-name=Jocasta]
border-color=#@INFO@

[urgency=critical]
border-color=#@URGENT@
default-timeout=0

# Focus mode (ultron focus): notifications are held until it ends.
[mode=do-not-disturb]
invisible=1
default-timeout=0
ignore-timeout=1
