#!/usr/bin/env bash
# ask "question": one-shot answer from the local model (ollama; ASK_MODEL setting, qwen3:4b by default).
# Piped input is passed through: `git diff | ask "summarise this"`.
set -euo pipefail

if [[ $# -eq 0 && -t 0 ]]; then
  echo 'Usage: ask "question"   (or: some-command | ask "what to do with it")' >&2
  exit 2
fi
if ! command -v ollama >/dev/null 2>&1; then
  echo "ask: local AI isn't installed on this machine. To add it: ultron conf set LOCAL_AI yes, then ultron install packages ai" >&2
  exit 1
fi

model=${ULTRON_ASK_MODEL:-}
if [[ -z "$model" ]] && command -v ultron >/dev/null 2>&1; then
  model=$(ultron conf get ASK_MODEL 2>/dev/null) || model=""
fi

# When stdin is a pipe, ollama run reads it and adds it to the prompt; exec keeps that stdin.
# --hidethinking, not --think=false: qwen3:4b ignored think=false in testing and printed its reasoning as the answer.
exec ollama run "${model:-qwen3:4b}" --hidethinking "$*"
