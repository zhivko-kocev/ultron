#!/usr/bin/env bash
# ultron session: greetd runs this as the user. It loads environment.d and starts sway.
set -euo pipefail

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export XDG_SESSION_TYPE=wayland

# Load ~/.config/environment.d (and the system ones) the same way the systemd user manager does.
# Each line is KEY=VALUE; values may contain spaces, so split at the first "=" only (no eval).
generator=/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator
if [[ -x $generator ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == *=* ]] || continue
    key=${line%%=*}
    [[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    export "$key=${line#*=}"
  done < <("$generator")
fi

mkdir -p "$XDG_RUNTIME_DIR/ultron"
# greetd starts sessions in /; everything sway execs (the boss, terminals) inherits this folder.
cd "$HOME"
exec systemd-cat --identifier=sway sway
