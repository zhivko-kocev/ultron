#!/usr/bin/env bash
# ultron-vm: test ultron in a QEMU/KVM virtual machine on the host (Phase B).
#   ultron-vm create              download and check the Arch ISO, make the disk and UEFI vars
#   ultron-vm run [--iso] [--nogl] start the VM (--iso boots the installer; ULTRON_VM_ISO picks another ISO)
#   ultron-vm type TEXT / key COMBO / shot FILE.png   drive a running VM (QMP)
#   ultron-vm ssh [CMD...]        ssh into the VM (needs sshd and your key in the VM)
#   ultron-vm destroy             delete the VM and its downloads
set -euo pipefail

STATE=${XDG_DATA_HOME:-$HOME/.local/share}/ultron-vm
MIRROR=https://geo.mirror.pkgbuild.com/iso/latest
FALLBACK_ISO=archlinux-2026.11.01-x86_64.iso
OVMF_CODE=/usr/share/edk2/x64/OVMF_CODE.4m.fd
OVMF_VARS=/usr/share/edk2/x64/OVMF_VARS.4m.fd
DISK_SIZE=40G
SSH_PORT=2222
QMP_SOCK=$STATE/qmp.sock

say() { printf '==> %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() {
  printf 'ultron-vm: %s\n' "$*" >&2
  exit 1
}
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is missing. Install it with: sudo pacman -S --needed $2"; }

usage() {
  cat <<'EOF'
Usage: ultron-vm <command>
  create               download and check the Arch ISO, make the 40G disk and the UEFI vars
  run [--iso] [--nogl] start the VM; --iso boots the installer; --nogl turns off 3D
  type TEXT            type TEXT into the VM (\n is Enter)
  key COMBO            press one key combination, like ret, ctrl-alt-f2 or meta_l-ret
  shot FILE.png        save a screenshot of the VM's screen
  ssh [CMD...]         ssh to the VM as $ULTRON_VM_USER (default: your user name), port 2222
  destroy              delete the VM disk and downloads (asks first)

Environment:
  ULTRON_VM_ISO=/path/to.iso   run --iso boots this file instead of the downloaded Arch ISO
                               (e.g. an ultron ISO from a release or iso/build)
EOF
}

# The ISO named in sha256sums.txt, or the plan's name when that file has none.
iso_name() {
  local name=""
  if [[ -f $STATE/sha256sums.txt ]]; then
    name=$(awk '$2 ~ /^archlinux-[0-9.]+-x86_64\.iso$/ { print $2; exit }' "$STATE/sha256sums.txt")
  fi
  printf '%s\n' "${name:-$FALLBACK_ISO}"
}

fetch() { # fetch URL FILE: download unless FILE exists (partial downloads resume)
  local url=$1 file=$2
  if [[ -f $file ]]; then
    say "Already downloaded: ${file##*/}"
    return 0
  fi
  say "Downloading ${file##*/}"
  curl -fL --retry 3 -C - -o "$file.part" "$url" || die "Download failed: $url (run create again to resume)"
  mv "$file.part" "$file"
}

verify_signature() { # verify_signature ISO
  local iso=$1
  if pacman-key -v "$iso.sig" >/dev/null 2>&1; then
    say "Signature OK (pacman keyring)"
    return 0
  fi
  if command -v gpg >/dev/null 2>&1 &&
    gpg --keyserver-options auto-key-retrieve --verify "$iso.sig" "$iso" >/dev/null 2>&1; then
    say "Signature OK (gpg with key retrieval)"
    return 0
  fi
  if [[ ${ULTRON_VM_SKIP_SIG:-} == 1 ]]; then
    warn "ISO signature NOT checked (ULTRON_VM_SKIP_SIG=1); only the SHA-256 checksum matched."
    return 0
  fi
  die "Could not verify the ISO's signature (pacman keyring and gpg both failed). The checksum file comes from the same mirror, so it proves nothing on its own. Check by hand with: pacman-key -v $iso.sig   (to continue anyway: ULTRON_VM_SKIP_SIG=1)"
}

cmd_create() {
  need curl curl
  need sha256sum coreutils
  need qemu-img qemu-desktop
  [[ -f $OVMF_VARS ]] || die "UEFI firmware is missing ($OVMF_VARS). Install it with: sudo pacman -S --needed edk2-ovmf"

  mkdir -p "$STATE"
  cd "$STATE"

  local free_gb
  free_gb=$(df -BG --output=avail "$STATE" | tail -n1 | tr -dc '0-9')
  if ((free_gb < 60)); then
    warn "Only ${free_gb} GB free in $STATE; the VM may need up to 60 GB."
  fi

  fetch "$MIRROR/sha256sums.txt" sha256sums.txt
  local iso
  iso=$(iso_name)
  fetch "$MIRROR/$iso" "$iso"
  fetch "$MIRROR/$iso.sig" "$iso.sig"

  say "Checking the ISO's SHA-256 checksum"
  grep -E "[[:space:]]\*?$iso\$" sha256sums.txt | sha256sum -c --ignore-missing - ||
    die "The ISO's checksum does not match. Delete $STATE/$iso and run create again."
  verify_signature "$iso"

  if [[ -f disk.qcow2 ]]; then
    say "Disk already exists: $STATE/disk.qcow2"
  else
    say "Creating a $DISK_SIZE disk"
    qemu-img create -f qcow2 disk.qcow2 "$DISK_SIZE"
  fi
  if [[ -f vars.fd ]]; then
    say "UEFI variables already exist"
  else
    say "Copying the UEFI variables"
    cp "$OVMF_VARS" vars.fd
  fi
  say "Ready. Start the installer with: ultron-vm run --iso"
}

# shellcheck disable=SC2054 # qemu options are comma-separated by design
cmd_run() {
  local with_iso=0 gl=1 arg iso=""
  for arg in "$@"; do
    case $arg in
    --iso) with_iso=1 ;;
    --nogl) gl=0 ;;
    *) die "Unknown option for run: $arg (use --iso and/or --nogl)" ;;
    esac
  done
  need qemu-system-x86_64 qemu-desktop
  [[ -e /dev/kvm ]] || die "/dev/kvm is missing: turn on SVM in the BIOS."
  [[ -f $OVMF_CODE ]] || die "UEFI firmware is missing ($OVMF_CODE). Install it with: sudo pacman -S --needed edk2-ovmf"
  [[ -d $STATE ]] || die "No VM yet. Run: ultron-vm create"
  if ((with_iso)) && [[ -n ${ULTRON_VM_ISO:-} ]]; then
    [[ -f $ULTRON_VM_ISO ]] || die "ULTRON_VM_ISO points at $ULTRON_VM_ISO, which doesn't exist."
    iso=$(realpath "$ULTRON_VM_ISO") # before the cd below, so a relative path works
  fi
  cd "$STATE"
  [[ -f disk.qcow2 && -f vars.fd ]] || die "The VM disk or UEFI vars are missing. Run: ultron-vm create"

  local qemu=(
    qemu-system-x86_64 -enable-kvm -machine q35 -cpu host -smp 6 -m 6144
    -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE"
    -drive if=pflash,format=raw,file=vars.fd
    -drive file=disk.qcow2,if=none,id=hd,format=qcow2
    -device virtio-blk-pci,drive=hd,bootindex=1
    -qmp "unix:$QMP_SOCK,server=on,wait=off"
  )
  if ((gl)); then
    qemu+=(-device virtio-vga-gl -display gtk,gl=on)
  else
    qemu+=(-device virtio-vga -display gtk)
  fi
  qemu+=(
    -nic "user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$SSH_PORT-:22"
    -device virtio-tablet-pci -device virtio-keyboard-pci
    -audiodev pipewire,id=a0 -device ich9-intel-hda -device hda-duplex,audiodev=a0
  )
  if ((with_iso)); then
    if [[ -z $iso ]]; then
      iso=$(iso_name)
      [[ -f $iso ]] || die "The ISO $iso is missing. Run: ultron-vm create"
    fi
    # bootindex, not -boot once=d: OVMF follows its saved boot order and ignores -boot once.
    qemu+=(-drive "file=$iso,if=none,id=cd,media=cdrom,readonly=on" -device ide-cd,drive=cd,bootindex=0)
  fi

  say "Starting the VM (Ctrl+Alt+G grabs input so Super keys reach the VM; press it again to release)"
  exec "${qemu[@]}"
}

# qmp COMMAND_JSON...: send QMP commands to the running VM, one after the other.
qmp() {
  [[ -S $QMP_SOCK ]] || die "The VM isn't running (no $QMP_SOCK). Start it with: ultron-vm run"
  python3 - "$QMP_SOCK" "$@" <<'PY'
import json, socket, sys, time
s = socket.socket(socket.AF_UNIX)
s.connect(sys.argv[1])
f = s.makefile("rw")
f.readline()
def call(cmd):
    f.write(json.dumps(cmd) + "\n"); f.flush()
    while True:
        r = json.loads(f.readline())
        if "return" in r: return r["return"]
        if "error" in r: sys.exit("qmp: " + r["error"]["desc"])
call({"execute": "qmp_capabilities"})
for arg in sys.argv[2:]:
    call(json.loads(arg)); time.sleep(0.02)
PY
}

# keys_json COMBO: send-key JSON for a combo like "ctrl-alt-f2" (qcode names joined by "-").
keys_json() {
  local IFS=- k out=""
  for k in $1; do out+="${out:+,}{\"type\":\"qcode\",\"data\":\"$k\"}"; done
  printf '{"execute":"send-key","arguments":{"keys":[%s]}}' "$out"
}

cmd_key() {
  [[ $# -gt 0 ]] || die "usage: ultron-vm key COMBO (e.g. ret, ctrl-alt-f2)"
  local c cmds=()
  for c in "$@"; do cmds+=("$(keys_json "$c")"); done
  qmp "${cmds[@]}"
}

cmd_type() {
  [[ $# -gt 0 ]] || die 'usage: ultron-vm type TEXT  (\n is Enter)'
  local text=$1 i ch combo cmds=()
  text=${text//\\n/$'\n'}
  for ((i = 0; i < ${#text}; i++)); do
    ch=${text:i:1}
    case $ch in
    [a-z0-9]) combo=$ch ;;
    [A-Z]) combo="shift-${ch,}" ;;
    ' ') combo=spc ;;
    $'\n') combo=ret ;;
    $'\t') combo=tab ;;
    -) combo=minus ;; =) combo=equal ;; '[') combo=bracket_left ;; ']') combo=bracket_right ;;
    \\) combo=backslash ;; ';') combo=semicolon ;; "'") combo=apostrophe ;; '`') combo=grave_accent ;;
    ,) combo=comma ;; .) combo="dot" ;; /) combo=slash ;;
    '!') combo=shift-1 ;; @) combo=shift-2 ;; '#') combo=shift-3 ;; '$') combo=shift-4 ;; %) combo=shift-5 ;;
    ^) combo=shift-6 ;; '&') combo=shift-7 ;; '*') combo=shift-8 ;; '(') combo=shift-9 ;; ')') combo=shift-0 ;;
    _) combo=shift-minus ;; +) combo=shift-equal ;; '{') combo=shift-bracket_left ;; '}') combo=shift-bracket_right ;;
    '|') combo=shift-backslash ;; :) combo=shift-semicolon ;; '"') combo=shift-apostrophe ;; '~') combo=shift-grave_accent ;;
    '<') combo=shift-comma ;; '>') combo=shift-dot ;; '?') combo=shift-slash ;;
    *) die "Can't type '$ch' into the VM" ;;
    esac
    cmds+=("$(keys_json "$combo")")
  done
  qmp "${cmds[@]}"
}

cmd_shot() {
  local file=${1:?usage: ultron-vm shot FILE.png}
  [[ $file == /* ]] || file=$PWD/$file
  qmp "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\"$file\",\"format\":\"png\"}}"
  say "Saved $file"
}

# cmd_ssh: ssh into the VM; uses $STATE/id_vm when it exists, user $ULTRON_VM_USER (default: $USER).
cmd_ssh() {
  local key=()
  if [[ -f $STATE/id_vm ]]; then key=(-i "$STATE/id_vm"); fi
  exec ssh -p "$SSH_PORT" "${key[@]}" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
    "${ULTRON_VM_USER:-$USER}@127.0.0.1" "$@"
}

cmd_destroy() {
  if [[ ! -d $STATE ]]; then
    say "Nothing to delete: $STATE does not exist"
    return 0
  fi
  du -sh "$STATE" 2>/dev/null || true
  local answer=""
  read -r -p "Delete the VM and its downloads in $STATE? [y/N] " answer || true
  case $answer in
  y | Y | yes | YES) ;;
  *)
    say "Kept $STATE"
    return 0
    ;;
  esac
  rm -rf -- "$STATE"
  say "Deleted $STATE"
}

main() {
  local cmd=${1:-}
  (($# > 0)) && shift
  case $cmd in
  create) cmd_create "$@" ;;
  run) cmd_run "$@" ;;
  type) cmd_type "$@" ;;
  key) cmd_key "$@" ;;
  shot) cmd_shot "$@" ;;
  ssh) cmd_ssh "$@" ;;
  destroy) cmd_destroy "$@" ;;
  -h | --help | help | "") usage ;;
  *)
    usage >&2
    die "Unknown command: $cmd"
    ;;
  esac
}

main "$@"
