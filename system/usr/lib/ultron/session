#!/usr/bin/env bash
# ultron session: greetd runs this as the user. It loads environment.d and starts sway.
set -euo pipefail

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export XDG_SESSION_TYPE=wayland

# Load ~/.config/environment.d (and the system ones) the same way the systemd user manager does.
# The generator prints KEY=VALUE and wraps values holding spaces or shell characters in "…" with
# backslash escapes ("wayland;xcb", "zeditor --wait"); that wrapping is undone here (no eval).
generator=/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator
if [[ -x $generator ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == *=* ]] || continue
    key=${line%%=*}
    [[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    val=${line#*=}
    if [[ $val == \"*\" && ${#val} -ge 2 ]]; then
      val=${val:1:${#val}-2}
      out="" i=0
      while ((i < ${#val})); do
        c=${val:i:1}
        if [[ $c == "\\" ]] && ((i + 1 < ${#val})); then
          i=$((i + 1))
          c=${val:i:1}
        fi
        out+=$c
        i=$((i + 1))
      done
      val=$out
    fi
    export "$key=$val"
  done < <("$generator")
fi

mkdir -p "$XDG_RUNTIME_DIR/ultron"
# greetd starts sessions in /; everything sway execs (the boss, terminals) inherits this folder.
cd "$HOME"
# A VM may have no GPU wlroots accepts (SwayFX renders through GLES); software rendering is fine there.
if systemd-detect-virt -q --vm; then export WLR_RENDERER_ALLOW_SOFTWARE=1; fi

# Render the configs for the compositor about to start: effects.conf turns SwayFX's options on only when
# SwayFX is the sway that runs (a SwayFX installed during the last session starts its effects here).
if [[ -x "$HOME/.local/bin/ultron" ]]; then
  env -u SWAYSOCK "$HOME/.local/bin/ultron" apply --no-reload >/dev/null 2>&1 || true
fi

# Not exec: when sway dies at once (say, a SwayFX that no longer starts after an update), the user gets a
# shell and the way back instead of a login loop.
start=$SECONDS rc=0
systemd-cat --identifier=sway sway || rc=$?
if ((rc != 0 && SECONDS - start < 10)); then
  echo "The desktop failed to start. After an update: reboot and pick a snapshot in the boot menu, or run: ultron conf set EFFECTS no && ultron install desktop"
  exec bash -l
fi
exit "$rc"
