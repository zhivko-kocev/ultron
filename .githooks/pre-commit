#!/usr/bin/env bash
# Stop commits that contain secrets.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so secrets can't be checked." >&2
  echo "Install it with: sudo pacman -S gitleaks   (then commit again)" >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner
