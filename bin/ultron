#!/usr/bin/env bash
# ultron: the OS command. `ultron <cmd> [args]` runs cmd_<cmd> from lib/cmd/<cmd>.sh.
set -euo pipefail

ULTRON_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export ULTRON_ROOT
# shellcheck source=../lib/common.sh
source "$ULTRON_ROOT/lib/common.sh"

usage() {
  cat <<'EOF'
usage: ultron <command> [args]

Everyday
  menu                everything in one menu (Super+Alt+Space)
  keys                key cheat sheet (Super+K)
  update              update ultron, packages, tools and agents
  doctor [--root|--deep]   check the system (no password needed without flags)
  theme [NAME|--list] switch the colour theme
  conf [list|get KEY|set KEY VALUE|edit]   this machine's settings
  setup TOPIC         wifi bluetooth audio display keyboard browser boss git dotfiles
                      timezone remote phone model
  pkg install|remove [NAME...]   packages (official and AUR)
  dev list|add|remove [TOOL]     languages and runtimes (mise)
  webapp add|remove|list         web apps as launcher entries
  install [step...]   install or repair (steps: preflight pacman dotfiles packages hardware
                      aur system boot ai docker desktop agents verify; on demand: jocasta net ntfy)
  migrate backup|restore|clean   move a home folder between installs

Agents
  agent list|add|remove|run|boss   coding agents (omp, claude, codex, gemini, opencode, ...)
  guide               the rules of this machine, for agents
  info [--json]       facts about this machine, for agents
  show review|web|watch|file|list|close   open something for the user on workspace 2 / 3 / 4
  attention [--raise TITLE|--done TITLE]  tell the user an agent needs them / has finished
  notify [--phone] [--urgent] TITLE BODY
  boss [--start]      start or show the boss window
  task                new thread (when the boss is Jocasta)

Desktop (bound to keys)
  browser [URL]       the everyday browser
  open-url URL        route a link: localhost to the preview, else the browser
  jump N [--con-id C|--app-id A]   move the user to workspace N (typing guard)
  back                return to the workspace before the last jump
  focus [toggle|on|off]   focus mode (agents don't move you)
  snap                region screenshot for the boss
  shot region|full    screenshots
  clip                clipboard history
  close               close the focused window (asks for the boss)
  power               power menu
  lock                lock the screen
  apply               regenerate themed config and reload

Internal: status, idle, attentiond, welcome, note
Docs: docs/ in the ultron folder (customize.md, agents.md, keys.md, security.md)
EOF
}

main() {
  local cmd=${1:-}
  case $cmd in
  "" | -h | --help | help)
    usage
    return 0
    ;;
  esac
  shift
  local file="$ULTRON_ROOT/lib/cmd/$cmd.sh"
  [[ "$cmd" =~ ^[a-z][a-z-]*$ && -f "$file" ]] || {
    usage >&2
    die "unknown command: $cmd"
  }
  # shellcheck source=/dev/null
  source "$file"
  "cmd_${cmd//-/_}" "$@"
}

main "$@"
