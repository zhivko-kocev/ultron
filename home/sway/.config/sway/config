set $mod Mod4
# No quotes: the names have no spaces, and a quoted $ws1 in the config's last `workspace` line
# made a second workspace literally named "1:boss" (quotes included).
set $ws1 1:boss
set $ws2 2:review
set $ws3 3:web
set $ws4 4:watch
set $ws5 5:code
set $ws6 6:term
set $ws7 7:chat
set $ws8 8
set $ws9 9:browse
set $ws10 10:sys
# Theme colours ($c_*), the font ($font), the background and the keyboard layout, written by `ultron apply`.
include ~/.config/ultron/generated/sway.conf
include ~/.config/ultron/generated/effects.conf
include /etc/sway/config.d/*
# Blocks are multi-line on purpose: sway ignores the settings of a one-line `{ a; b }` block.
input type:keyboard {
  repeat_delay 300
  repeat_rate 40
}
input type:touchpad {
  tap enabled
  natural_scroll enabled
  dwt enabled
}
seat * xcursor_theme Adwaita 24
default_border pixel 2
default_floating_border pixel 2
gaps inner 4
floating_modifier $mod normal
focus_on_window_activation urgent
client.focused          $c_accent  $c_bg_alt $c_fg     $c_accent_alt $c_accent
client.focused_inactive $c_bg_sel  $c_bg     $c_fg_dim $c_bg_sel     $c_bg_sel
client.unfocused        $c_bg_alt  $c_bg     $c_muted  $c_bg_alt     $c_bg_alt
client.urgent           $c_urgent  $c_urgent $c_bg     $c_urgent     $c_urgent
assign [app_id="^ultron-boss$"] workspace $ws1
assign [app_id="^ultron-review-"] workspace $ws2
assign [app_id="^ultron-watch-"] workspace $ws4
assign [app_id="^dev\.zed\.Zed$"] workspace $ws5
assign [app_id="^ultron-sys"] workspace $ws10
# The preview browser of `ultron show web` (its --profile-directory=UltronPreview); your web apps are -Default.
assign [app_id="__-UltronPreview$"] workspace $ws3
no_focus [app_id="__-UltronPreview$"]
# Jocasta's own windows (0.2 on): review, show and morning-brief pages on 2, the board on 4.
assign [app_id="^jocasta-(review|show|brief)$"] workspace $ws2
assign [app_id="^jocasta-board$"] workspace $ws4
no_focus [app_id="^jocasta-"]
for_window [app_id="^(org\.pulseaudio\.pavucontrol|swappy|imv|ultron-float)$"] floating enable
# Workspaces 2-4 (what agents show you) are tabs. Runs after the window is placed, so assigned windows match.
for_window [workspace="^(2:review|3:web|4:watch)$"] layout tabbed
bar {
  position top
  status_command ultron status
  font $font
  colors {
    background $c_bg
    statusline $c_fg
    separator $c_bg_sel
    focused_workspace $c_accent $c_accent $c_bg
    active_workspace $c_bg_sel $c_bg_sel $c_fg
    inactive_workspace $c_bg $c_bg $c_fg_dim
    urgent_workspace $c_urgent $c_urgent $c_bg
  }
}
# exec_always: a reload (ultron apply) restarts swayidle with the new timeouts.
exec_always ultron idle
exec mako
exec wl-paste --watch cliphist store
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec sh -c 'systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP DISPLAY && systemctl --user start ultron-attentiond.service'
exec foot --app-id=ultron-sys btop
exec ultron boss --start
exec ultron welcome --once
workspace $ws1

# Workspaces. These come before every other binding on purpose: sway names the workspace it starts on
# after the first workspace binding in this file, and that must be 1:boss.
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10
bindsym $mod+Shift+1 move container to workspace $ws1; workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2; workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3; workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4; workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5; workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6; workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7; workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8; workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9; workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10; workspace $ws10
bindsym $mod+Shift+Mod1+1 move container to workspace $ws1
bindsym $mod+Shift+Mod1+2 move container to workspace $ws2
bindsym $mod+Shift+Mod1+3 move container to workspace $ws3
bindsym $mod+Shift+Mod1+4 move container to workspace $ws4
bindsym $mod+Shift+Mod1+5 move container to workspace $ws5
bindsym $mod+Shift+Mod1+6 move container to workspace $ws6
bindsym $mod+Shift+Mod1+7 move container to workspace $ws7
bindsym $mod+Shift+Mod1+8 move container to workspace $ws8
bindsym $mod+Shift+Mod1+9 move container to workspace $ws9
bindsym $mod+Shift+Mod1+0 move container to workspace $ws10
bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym $mod+Ctrl+Tab workspace back_and_forth

# Apps
bindsym $mod+Return exec foot
bindsym $mod+Shift+Return workspace $ws9; exec ultron browser
bindsym $mod+Shift+b workspace $ws9; exec ultron browser
bindsym $mod+Shift+f exec thunar
bindsym $mod+Shift+n workspace $ws5; exec zeditor
bindsym $mod+space exec fuzzel
bindsym $mod+Mod1+space exec ultron menu
bindsym $mod+Escape exec ultron power
bindsym $mod+k exec ultron keys
bindsym $mod+Ctrl+a exec pavucontrol
bindsym $mod+Ctrl+u workspace $ws10; exec foot --app-id=ultron-sys-update --hold -- ultron update

# Windows
bindsym $mod+w exec ultron close
bindsym $mod+q exec ultron close
bindsym $mod+t floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+j layout toggle split
bindsym $mod+o floating enable; sticky enable
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+minus resize shrink width 50px
bindsym $mod+equal resize grow width 50px
bindsym $mod+Shift+minus resize shrink height 50px
bindsym $mod+Shift+equal resize grow height 50px
bindsym $mod+s scratchpad show
bindsym $mod+Mod1+s move scratchpad

# System
bindsym $mod+Ctrl+l exec ultron lock
bindsym $mod+Ctrl+v exec ultron pick clip
bindsym $mod+Ctrl+e exec ultron pick emoji
bindsym $mod+comma exec makoctl dismiss
bindsym $mod+Shift+comma exec makoctl dismiss --all
bindsym Print exec ultron shot region
bindsym Shift+Print exec ultron shot full
bindsym $mod+Shift+c reload

# Media and brightness keys (work on the lock screen too)
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

# Agentic keys
bindsym $mod+b exec ultron boss
bindsym $mod+BackSpace workspace back_and_forth
bindsym $mod+a exec ultron attention
bindsym $mod+n exec ultron task
bindsym $mod+Shift+s exec ultron snap
bindsym $mod+m exec ultron focus toggle
bindsym $mod+Shift+j exec ultron note jocasta

# Your overrides (bindings, outputs, inputs, window rules) come last, so they win.
include ~/.config/ultron/sway/*.conf
